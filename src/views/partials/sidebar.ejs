        <h1 class="text-base font-bold text-slate-900 leading-tight">Clínica Del Llano</h1>
        <p class="text-xs text-slate-400">Portal Médico</p>
      </div>
    </div>
  </div>

  <!-- Nav -->
  <nav class="flex-1 px-3 py-4 overflow-y-auto">
    <ul class="space-y-1">
      <li>
        <a href="/pacientes"
          class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition text-sm font-medium
          <%= typeof activePage !== 'undefined' && activePage === 'pacientes' ? 'bg-blue-50 text-blue-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24"
