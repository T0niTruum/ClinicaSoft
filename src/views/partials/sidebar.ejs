<aside class="w-64 bg-white shadow-lg h-screen fixed flex flex-col" style="border-right:1px solid #e2efff;">
  <!-- Logo -->
  <div class="px-6 py-5 border-b border-slate-100">
    <div class="flex items-center gap-3">
      <div
        class="flex h-10 w-10 items-center justify-center rounded-2xl bg-blue-600 text-white font-bold text-lg shadow">C
