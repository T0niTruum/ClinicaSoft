<header class="bg-white border-b fixed w-full left-64 top-0 z-10">
  <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <form class="relative">
        <input type="search" placeholder="Buscar..." class="pl-10 pr-4 py-2 rounded-lg border w-72 focus:outline-none focus:ring-2 focus:ring-emerald-200" />
        <svg class="w-5 h-5 absolute left-3 top-2.5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
      </form>
    </div>

    <div class="flex items-center gap-4">
      <button class="relative p-2 rounded hover:bg-gray-50">
        <svg class="w-6 h-6 text-gray-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        <span class="absolute -top-1 -right-1 inline-flex items-center justify-center px-1.5 py-0.5 text-xs font-bold leading-none text-white bg-red-600 rounded">3</span>
      </button>

      <div class="flex items-center gap-3">
        <div class="text-right">
          <div class="text-sm font-medium">Administrador</div>
          <div class="text-xs text-gray-500">Recepción</div>
        </div>
        <img src="/public/images/avatar.png" alt="avatar" class="w-10 h-10 rounded-full object-cover border" />
      </div>
    </div>
  </div>
</header>
