<div id="toast-container" class="fixed top-6 right-6 z-50 space-y-3"></div>
<script>
  function showToast(type, message, timeout = 5000) {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const id = 'toast-' + Date.now();
    const color = type === 'success' ? 'bg-emerald-500' : 'bg-red-500';
    const html = `
      <div id="${id}" class="max-w-sm w-full ${color} text-white shadow-lg rounded-lg p-4 flex items-start gap-3 animate-fade">
        <div class="flex-1">
          <div class="font-semibold">${type === 'success' ? 'Éxito' : 'Error'}</div>
          <div class="text-sm">${message}</div>
        </div>
        <button onclick="document.getElementById('${id}').remove()" class="text-white opacity-80">✕</button>
      </div>
    `;
    container.insertAdjacentHTML('beforeend', html);
    setTimeout(() => { const el = document.getElementById(id); if (el) el.remove(); }, timeout);
  }
</script>
