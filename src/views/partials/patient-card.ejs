<div class="bg-white shadow rounded-lg p-4 flex gap-4 items-center">
  <div class="w-16 h-16 rounded-full bg-gray-100 overflow-hidden flex items-center justify-center">
    <% if (patient && patient.persona && patient.persona.avatar) { %>
      <img src="<%= patient.persona.avatar %>" alt="avatar" class="w-full h-full object-cover" />
    <% } else { %>
      <svg class="w-8 h-8 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14c4 0 6-2 6-4s-2-4-6-4-6 2-6 4 2 4 6 4zM12 14v7"/></svg>
    <% } %>
  </div>
  <div class="flex-1">
    <div class="text-lg font-semibold"><%= patient.persona.nombre %> <%= patient.persona.apellido %></div>
    <div class="text-sm text-gray-500"> <strong>ID:</strong> <%= patient.persona.tipoDocumento %> <%= patient.persona.documento %></div>
    <div class="flex gap-4 text-sm text-gray-600 mt-1">
      <div><strong>Tel:</strong> <%= patient.persona.telefono || '—' %></div>
      <div><strong>Email:</strong> <%= patient.persona.email || '—' %></div>
    </div>
  </div>
  <div class="text-right">
    <% if (patient.paciente.estadoPaciente === 'ACTIVO') { %>
      <span class="inline-block bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full text-sm">Paciente Activo</span>
    <% } else { %>
      <span class="inline-block bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm">Paciente Inactivo</span>
    <% } %>
  </div>
</div>
