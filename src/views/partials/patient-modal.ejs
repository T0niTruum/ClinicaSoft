<div x-show="modalOpen" x-transition.opacity
  class="fixed inset-0 z-50 flex items-center justify-center modal-backdrop px-4 py-6" style="display:none;">
  <div @click.outside="closeModal()" x-show="modalOpen" x-transition
    class="relative w-full max-w-xl rounded-2xl bg-white shadow-2xl animate-fade-in overflow-hidden">

    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24"
          stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <h2 class="text-base font-bold text-blue-700"
          x-text="isEditing ? 'Registro / Edición de Paciente' : 'Registro / Edición de Paciente'"></h2>
      </div>
      <button @click="closeModal()"
        class="rounded-full p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <form @submit.prevent="savePatient()" class="overflow-y-auto" style="max-height: calc(90vh - 130px);">
      <fieldset :disabled="isViewing" class="px-6 py-5 space-y-5">

        <!-- Section: Información Personal -->
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Información Personal</p>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Tipo de Documento</label>
              <div class="relative">
                <select x-model="form.tipoDocumento"
                  :class="(isEditing || isViewing) ? 'bg-slate-100 cursor-not-allowed' : 'bg-white'"
                  :disabled="isEditing || isViewing"
                  class="w-full appearance-none rounded-xl border border-slate-200 px-3 py-2.5 text-sm text-slate-700 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-100 pr-8">
                  <option value="">Seleccione</option>
                  <option value="CC">CC - Cédula de Ciudadanía</option>
                  <option value="TI">TI - Tarjeta de Identidad</option>
                  <option value="CE">CE - Cédula de Extranjería</option>
                  <option value="RC">RC - Registro Civil</option>
                </select>
                <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400"
                  xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                  stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Número de Documento</label>
              <input x-model="form.documento" type="text" :readonly="isEditing || isViewing"
                :class="(isEditing || isViewing) ? 'bg-slate-100 cursor-not-allowed' : 'bg-white'"
                class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm text-slate-700 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-100"
                placeholder="123456789" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 mt-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Nombres</label>
              <input x-model="form.nombre" type="text" placeholder="Ingrese nombres"
                class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-100" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Apellidos</label>
              <input x-model="form.apellido" type="text" placeholder="Ingrese apellidos"
                class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-100" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 mt-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Fecha de Nacimiento</label>
              <input x-model="form.fechaNacimiento" type="date"
                class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-100" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Estado Civil</label>
              <div class="relative">
                <select x-model="form.estadoCivil"
                  class="w-full appearance-none rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-100 pr-8">
                  <option value="">Seleccione...</option>
                  <option>Soltero/a</option>
                  <option>Casado/a</option>
                  <option>Unión libre</option>
                  <option>Divorciado/a</option>
                  <option>Viudo/a</option>
                </select>
                <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400"
                  xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                  stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Divider -->
        <div class="border-t border-slate-100"></div>

        <!-- Section: Contacto y Estado -->
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Contacto y Estado</p>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Correo Electrónico</label>
              <input x-model="form.email" type="email" @input="validateEmail()"
                :class="emailInvalid ? 'border-red-400 focus:ring-red-100 focus:border-red-400' : 'border-slate-200 focus:border-blue-400 focus:ring-blue-100'"
                class="w-full rounded-xl border bg-white px-3 py-2.5 text-sm text-slate-700 focus:outline-none focus:ring-2"
                placeholder="paciente@ejemplo.com" />
              <p x-show="emailInvalid" class="text-xs text-red-500 mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="inline h-3 w-3 mr-0.5" fill="none" viewBox="0 0 24 24"
                  stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 8v4M12 16h.01" />
                </svg>
                Formato de correo electrónico inválido (Ej: usuario@dominio.com)
              </p>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Teléfono</label>
              <div
                class="flex items-center rounded-xl border border-slate-200 bg-white px-3 py-2.5 gap-2 focus-within:border-blue-400 focus-within:ring-2 focus-within:ring-blue-100">
                <span class="text-sm text-slate-400 flex-shrink-0">+57</span>
                <div class="w-px h-4 bg-slate-200"></div>
                <input x-model="form.telefono" type="text"
                  class="w-full bg-transparent text-sm text-slate-700 focus:outline-none" placeholder="300 000 0000" />
              </div>
            </div>
          </div>

          <!-- Estado del Paciente toggle -->
          <div class="mt-4">
            <label class="block text-sm font-medium text-slate-700 mb-2">Estado del Paciente</label>
            <div class="flex items-center gap-3">
              <!-- Toggle switch -->
              <button type="button" @click="toggleStatus()"
                :class="form.estadoPaciente === 'ACTIVO' ? 'bg-emerald-500' : 'bg-slate-300'"
                class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 focus:outline-none">
                <span :class="form.estadoPaciente === 'ACTIVO' ? 'translate-x-5' : 'translate-x-0'"
                  class="inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200"></span>
              </button>
              <span class="text-sm font-semibold"
                :class="form.estadoPaciente === 'ACTIVO' ? 'text-emerald-700' : 'text-slate-500'"
                x-text="form.estadoPaciente === 'ACTIVO' ? 'ACTIVO' : 'INACTIVO'"></span>
            </div>

            <!-- Info note -->
            <div
              class="mt-3 flex items-start gap-2.5 rounded-xl border border-blue-100 bg-blue-50 px-3.5 py-3 text-sm text-slate-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 flex-shrink-0 mt-0.5" fill="none"
                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 8v4M12 16h.01" />
              </svg>
              <p>Nota: Los pacientes en estado INACTIVO no podrán agendar nuevas citas médicas.</p>
            </div>
          </div>
        </div>

      </fieldset>
    </form>

    <!-- Footer actions -->
    <div class="border-t border-slate-100 px-6 py-4 flex items-center justify-end gap-3 bg-white">
      <button @click="closeModal()"
        class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition">
        Cancelar
      </button>
      <button x-show="!isViewing" @click="savePatient()" :disabled="saving || emailInvalid"
        class="inline-flex items-center gap-2 rounded-xl bg-blue-700 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-800 transition disabled:opacity-50">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span x-show="!saving">Guardar Paciente</span>
        <span x-show="saving">Guardando...</span>
      </button>
    </div>
  </div>
</div>