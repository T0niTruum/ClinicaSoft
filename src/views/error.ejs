<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Error</title>
</head>
<body>
  <h1>Error</h1>
  <p><%= error.message %></p>
  <% if (error.errors && error.errors.length) { %>
    <ul>
      <% error.errors.forEach((item) => { %>
        <li><%= item.field ? item.field + ': ' : '' %><%= item.message %></li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>
