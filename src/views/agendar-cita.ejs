<!DOCTYPE html>
<html lang="es" x-data>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Agendar Cita - Clínica Del Llano</title>
  <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css" />
  <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <style>
    .stepper-dot { width: 10px; height: 10px; border-radius: 50%; }
    .animate-fade { animation: fadeIn .4s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(-4px);} to { opacity:1; transform: translateY(0);} }
  </style>
</head>
<body class="bg-slate-50 text-slate-800">

  <%- include('partials/sidebar') %>
  <div class="ml-64">
    <%- include('partials/header') %>

    <main class="max-w-7xl mx-auto p-6 pt-24">
      <%- include('partials/toast') %>

      <div class="panel-card card-shadow p-6">
        <h2 class="text-2xl font-semibold mb-4 page-header">Agendar Cita</h2>

        <!-- Stepper -->
        <div x-data="agendarCita()" x-init="init()" class="space-y-6">
          <div class="flex items-center gap-4">
            <template x-for="(s, i) in steps" :key="i">
              <div class="flex items-center">
                <div :class="{'bg-emerald-500 text-white': step>i, 'bg-emerald-100 text-emerald-600': step===i, 'bg-gray-200 text-gray-500': step<i}
                    class="w-10 h-10 flex items-center justify-center rounded-full font-medium"> 
                  <span x-text="i+1"></span>
                </div>
                <div class="ml-3 mr-6 text-sm" :class="{'text-emerald-700': step>=i}">
                  <div x-text="s"></div>
                </div>
              </div>
            </template>
          </div>

          <!-- Step Panels -->
          <div>
            <!-- Step 1: Verificación de Paciente -->
            <div x-show="step===0" class="space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="md:col-span-2">
                  <label class="block text-sm font-medium text-gray-700">Tipo de documento</label>
                  <select x-model="form.tipoDocumento" class="mt-1 block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-700 transition shadow-sm focus:border-blue-500 focus:ring-4 focus:ring-blue-100">
                    <option value="">Seleccione</option>
                    <option value="CC">Cédula de Ciudadanía</option>
                    <option value="TI">Tarjeta de Identidad</option>
                    <option value="RC">Registro Civil</option>
                    <option value="CE">Cédula Extranjería</option>
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700">Número de documento</label>
                  <input x-model="form.documento" type="text" @keydown.enter.prevent="verifyPatient()" class="mt-1 block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-700 transition shadow-sm focus:border-blue-500 focus:ring-4 focus:ring-blue-100" placeholder="Número de documento" />
                </div>

                <div class="md:col-span-3 flex items-end">
                  <button @click.prevent="verifyPatient()" :disabled="loading.verify" class="btn-primary disabled:opacity-60">
                    <span x-show="!loading.verify">Verificar Paciente</span>
                    <span x-show="loading.verify">Verificando...</span>
                  </button>
                </div>
              </div>

              <div x-show="patient !== null" class="mt-4">
                <div x-show="patient" class="mt-4">
                  <div class="bg-white shadow rounded-lg p-4">
                    <div class="flex items-center justify-between">
                      <div>
                        <div class="font-semibold text-lg" x-text="patient.persona.nombre + ' ' + patient.persona.apellido"></div>
                        <div class="text-sm text-gray-500" x-text="patient.persona.tipoDocumento + ' ' + patient.persona.documento"></div>
                      </div>
                      <div>
                        <span x-text="patient.paciente.estadoPaciente === 'ACTIVO' ? 'Paciente Activo' : 'Paciente Inactivo'" :class="patient.paciente.estadoPaciente === 'ACTIVO' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'" class="px-3 py-1 rounded-full text-sm"></span>
                      </div>
                    </div>
                    <div class="mt-3 text-sm text-gray-600">
                      <div><strong>Tel:</strong> <span x-text="patient.persona.telefono || '—'"></span></div>
                      <div><strong>Email:</strong> <span x-text="patient.persona.email || '—'"></span></div>
                    </div>
                  </div>
                </div>
              </div>

              <div x-show="errorBanner" class="mt-4 p-3 rounded shadow bg-red-50 border-l-4 border-red-400 text-red-700">
                <div x-text="errorBanner"></div>
              </div>

            </div>

            <!-- Step 2: Selección de Especialidad -->
            <div x-show="step===1" class="space-y-4">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-emerald-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 1.343-3 3v1h6v-1c0-1.657-1.343-3-3-3z"/></svg>
                <h3 class="text-lg font-medium">Selecciona la especialidad</h3>
              </div>

              <div>
                <select x-model="form.especialidadId" @change="onSelectEspecialidad()" class="w-full rounded border-gray-200 p-2">
                  <option value="">-- Seleccionar Especialidad --</option>
                  <template x-for="esp in especialidades" :key="esp.id">
                    <option :value="esp.id" x-text="esp.nombre"></option>
                  </template>
                </select>
              </div>

              <div x-show="especialidades.length===0" class="text-gray-500">No hay especialidades disponibles.</div>
            </div>

            <!-- Step 3: Selección de Médico -->
            <div x-show="step===2" class="space-y-4">
              <h3 class="text-lg font-medium">Médicos</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <template x-for="med in medicos" :key="med.id">
                  <div :class="med.disponibilidad ? 'border-emerald-200' : 'opacity-60'" class="bg-white rounded-lg shadow p-4 border">
                    <div class="flex items-center justify-between">
                      <div>
                        <div class="font-semibold" x-text="med.persona.nombre + ' ' + med.persona.apellido"></div>
                        <div class="text-sm text-gray-500">Tarjeta: <span x-text="med.tarjetaProfesional || '—'"></span></div>
                      </div>
                      <div>
                        <span x-text="med.disponibilidad ? 'Disponible' : 'No disponible'" :class="med.disponibilidad ? 'bg-emerald-100 text-emerald-700' : 'bg-gray-100 text-gray-600'" class="px-3 py-1 rounded-full text-sm"></span>
                      </div>
                    </div>
                    <div class="mt-3 flex justify-end">
                      <button @click.prevent="selectMedico(med)" :disabled="!med.disponibilidad" class="btn-secondary disabled:opacity-50">Seleccionar</button>
                    </div>
                  </div>
                </template>
              </div>

              <div x-show="medicos.length===0" class="text-gray-500">No hay médicos para la especialidad seleccionada.</div>
            </div>

            <!-- Step 4: Selección de Horario -->
            <div x-show="step===3" class="space-y-4">
              <h3 class="text-lg font-medium">Horarios</h3>

              <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="col-span-1 md:col-span-1">
                  <!-- Mini calendario (simplificado) -->
                  <div class="bg-white p-4 rounded shadow">
                    <div class="text-sm text-gray-500 mb-2">Selector de fecha</div>
                    <input type="date" x-model="selectedDate" @change="loadHorarios()" class="w-full p-2 border rounded" />
                  </div>
                </div>

                <div class="col-span-1 md:col-span-3">
                  <div class="bg-white p-4 rounded shadow">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                      <template x-for="h in horarios" :key="h.id">
                        <button @click.prevent="selectHorario(h)" :disabled="!h.disponible || new Date(h.horaInicio) <= new Date()" :class="{
                          'bg-emerald-600 text-white': selectedHorario && selectedHorario.id===h.id,
                          'bg-blue-50 text-emerald-700 hover:shadow-lg': h.disponible && !(selectedHorario && selectedHorario.id===h.id),
                          'bg-gray-100 text-gray-400 cursor-not-allowed': !h.disponible || new Date(h.horaInicio) <= new Date()
                        }" class="rounded p-3 text-sm border">
                          <div x-text="(new Date(h.horaInicio)).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})"></div>
                          <div class="text-xs text-gray-500" x-text="(new Date(h.horaInicio)).toLocaleDateString()"></div>
                        </button>
                      </template>
                    </div>
                    <div x-show="horarios.length===0" class="text-gray-500 mt-2">No hay horarios disponibles para la fecha seleccionada.</div>
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700">Motivo de la consulta</label>
                <textarea x-model="form.motivo" maxlength="500" class="mt-1 block w-full rounded-md border-gray-200 p-3" placeholder="Describa brevemente el motivo de la consulta (síntomas, antecedentes relevantes, objetivo de la cita)"></textarea>
                <div class="text-xs text-gray-400 mt-1"><span x-text="form.motivo.length"></span>/500</div>
              </div>

              <div class="flex justify-end gap-3">
                <button @click.prevent="prev()" class="btn-secondary">Atrás</button>
                <button @click.prevent="confirmAgendar()" :disabled="isSubmitting" class="btn-primary disabled:opacity-60">
                  <span x-show="!isSubmitting">Confirmar y Registrar Agendamiento</span>
                  <span x-show="isSubmitting">Procesando...</span>
                </button>
              </div>
            </div>

          </div>

        </div>

      </div>
    </main>
  </div>

  <script src="/js/agendar-cita.js"></script>
</body>
</html>