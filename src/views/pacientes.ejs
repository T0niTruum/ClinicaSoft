<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gestión de Pacientes | Clínica Del Llano</title>
  <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
  <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <style>
    .modal-backdrop {
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(2px);
    }

    .animate-fade-in {
      animation: fadeIn 0.2s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .input-invalid {
      border-color: #ef4444 !important;
    }

    .text-invalid {
      color: #b91c1c;
    }

    .avatar-circle {
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      font-weight: 700;
      flex-shrink: 0;
    }

    header {
      height: 56px;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800">
  <%- include('partials/sidebar', { activePage: 'pacientes' }) %>
    <div x-data="pacienteManager" x-init="init()" class="ml-64 min-h-screen bg-slate-50">
      <%- include('partials/header') %>

        <main class="px-6 py-8" style="padding-top:4.5rem;">
          <%- include('partials/toast') %>

            <!-- Page header row -->
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between mb-6">
              <div>
                <h1 class="text-2xl font-bold text-slate-900">Gestión de Pacientes</h1>
                <p class="text-sm text-slate-500 mt-1">Administre el directorio de pacientes de la clínica.</p>
              </div>
              <div class="flex items-center gap-3 flex-wrap">
                <!-- Search by doc -->
                <div class="relative">
                  <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
                    xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
                  </svg>
                  <input x-model="filters.documento" @input.debounce.300ms="loadPatients()" type="text"
                    placeholder="Buscar por Documento..."
                    class="pl-9 pr-4 py-2 rounded-xl border border-slate-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-400 w-56" />
                </div>
                <!-- Register button -->
                <button @click="openPatientModal()"
                  class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  + Registrar Nuevo Paciente
                </button>
              </div>
            </div>

            <!-- Table card -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
              <div class="overflow-x-auto">
                <table class="min-w-full text-left">
                  <thead>
                    <tr
                      class="border-b border-slate-100 bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500">
                      <th class="px-5 py-3.5">Tipo Doc.</th>
                      <th class="px-5 py-3.5">Documento</th>
                      <th class="px-5 py-3.5">Paciente</th>
                      <th class="px-5 py-3.5">Correo Electrónico</th>
                      <th class="px-5 py-3.5">Teléfono</th>
                      <th class="px-5 py-3.5">Estado</th>
                      <th class="px-5 py-3.5">Acciones</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">

                    <!-- Loading skeleton -->
                    <template x-if="loading.patients">
                      <tr>
                        <td colspan="7" class="px-5 py-10 text-center text-slate-400 text-sm">
                          <div class="flex justify-center items-center gap-2">
                            <svg class="animate-spin h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg"
                              fill="none" viewBox="0 0 24 24">
                              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                              </circle>
                              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                            </svg>
                            Cargando pacientes...
                          </div>
                        </td>
                      </tr>
                    </template>

                    <!-- Empty state -->
                    <template x-if="!loading.patients && patients.length === 0">
                      <tr>
                        <td colspan="7" class="px-5 py-12 text-center text-slate-400 text-sm">No se encontraron
                          pacientes. Intenta otro filtro o registra uno nuevo.</td>
                      </tr>
                    </template>

                    <!-- Rows -->
                    <template x-for="paciente in patients" :key="paciente.id">
                      <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-5 py-3.5 text-sm text-slate-600 font-medium"
                          x-text="paciente.persona.tipoDocumento"></td>
                        <td class="px-5 py-3.5 text-sm text-slate-700" x-text="paciente.persona.documento"></td>
                        <td class="px-5 py-3.5">
                          <div class="flex items-center gap-2.5">
                            <div class="avatar-circle text-white"
                              :style="`background: ${paciente.estadoPaciente === 'ACTIVO' ? '#2563eb' : '#64748b'}`"
                              x-text="(paciente.persona.nombre[0] || '') + (paciente.persona.apellido[0] || '')">
                            </div>
                            <span class="text-sm font-medium text-slate-800"
                              x-text="paciente.persona.nombre + ' ' + paciente.persona.apellido"></span>
                          </div>
                        </td>
                        <td class="px-5 py-3.5 text-sm text-slate-600" x-text="paciente.persona.email || '—'"></td>
                        <td class="px-5 py-3.5 text-sm text-slate-600"
                          x-text="paciente.persona.telefono ? ('+57 ' + paciente.persona.telefono) : '—'"></td>
                        <td class="px-5 py-3.5">
                          <span x-text="paciente.estadoPaciente === 'ACTIVO' ? 'Activo' : 'Inactivo'"
                            :class="paciente.estadoPaciente === 'ACTIVO' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-600'"
                            class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold">
                          </span>
                        </td>
                        <td class="px-5 py-3.5">
                          <div class="flex items-center gap-1">
                            <a :href="'/citas?pacienteId=' + paciente.id" title="Historial de citas"
                              class="p-1.5 rounded-lg hover:bg-emerald-50 text-emerald-600 transition inline-flex">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M8 7V3m8 4V3M3 11h18M5 21h14a2 2 0 002-2V7H3v12a2 2 0 002 2z" />
                              </svg>
                            </a>
                            <button @click.prevent="viewPatient(paciente)" title="Ver"
                              class="p-1.5 rounded-lg hover:bg-slate-100 text-slate-500 transition">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                              </svg>
                            </button>
                            <button @click.prevent="openPatientModal(paciente)" title="Editar"
                              class="p-1.5 rounded-lg hover:bg-blue-50 text-blue-500 transition">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                              </svg>
                            </button>
                            <button @click.prevent="openConfirmModal(paciente)" title="Inactivar"
                              class="p-1.5 rounded-lg hover:bg-rose-50 text-rose-500 transition">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                              </svg>
                            </button>
                            <button @click.prevent="openConfirmModal(paciente)" title="Inactivar"
                              class="p-1.5 rounded-lg hover:bg-rose-50 text-rose-500 transition">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                              </svg>
                            </button>
                          </div>
                        </td>
                      </tr>
                    </template>
                  </tbody>
                </table>
              </div>

              <!-- Pagination footer -->
              <div
                class="border-t border-slate-100 px-5 py-3 flex items-center justify-between text-sm text-slate-500 bg-slate-50">
                <span
                  x-text="patients.length > 0 ? `Mostrando 1 a ${patients.length} de ${totalPatients} pacientes` : 'Sin resultados'"></span>
                <div class="flex items-center gap-1">
                  <button @click="prevPage()" :disabled="currentPage <= 1"
                    class="p-1.5 rounded-lg hover:bg-slate-200 disabled:opacity-40 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                      stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                  </button>
                  <button @click="nextPage()" :disabled="patients.length < pageSize"
                    class="p-1.5 rounded-lg hover:bg-slate-200 disabled:opacity-40 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                      stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <%- include('partials/patient-modal') %>
              <%- include('partials/confirm-modal') %>
        </main>
    </div>

    <script src="/js/pacientes.js"></script>
</body>

</html>