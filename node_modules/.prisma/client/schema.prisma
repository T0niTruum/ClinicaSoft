generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoDocumento {
  RC
  TI
  CC
  CE
}

enum EstadoPaciente {
  ACTIVO
  INACTIVO
}

enum EstadoCita {
  PENDIENTE
  ASIGNADO
  CANCELADO
  FINALIZADO
}

model Persona {
  id            String        @id @default(uuid())
  nombre        String
  apellido      String
  tipoDocumento TipoDocumento
  documento     String
  email         String?
  telefono      String?

  paciente Paciente?
  medico   Medico?

  @@unique([tipoDocumento, documento])
}

model Paciente {
  id              String         @id
  fechaNacimiento DateTime?
  estadoCivil     String?
  estadoPaciente  EstadoPaciente @default(ACTIVO)

  persona Persona @relation(fields: [id], references: [id], onDelete: Cascade)
  citas   Cita[]
}

model Especialidad {
  id             String  @id @default(uuid())
  nombre         String
  descripcion    String?
  disponibilidad Boolean @default(true)

  medicos Medico[]
}

model Medico {
  id                 String  @id
  tarjetaProfesional String?
  disponibilidad     Boolean @default(true)
  especialidadId     String

  persona      Persona      @relation(fields: [id], references: [id], onDelete: Cascade)
  especialidad Especialidad @relation(fields: [especialidadId], references: [id])
  horarios     Horario[]
  citas        Cita[]
}

model Horario {
  id         String   @id @default(uuid())
  fecha      DateTime
  horaInicio DateTime
  horaFin    DateTime
  disponible Boolean  @default(true)
  medicoId   String

  medico Medico @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  cita   Cita?

  @@index([medicoId])
}

model Cita {
  id            String     @id @default(uuid())
  pacienteId    String
  medicoId      String
  horarioId     String     @unique
  motivo        String?
  estado        EstadoCita @default(PENDIENTE)
  fechaCreacion DateTime   @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  medico   Medico   @relation(fields: [medicoId], references: [id])
  horario  Horario  @relation(fields: [horarioId], references: [id])
}
